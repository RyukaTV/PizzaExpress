{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} | Menu{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block body %}
<section id="menu" class="py-5 bg-light">
    <div class="container">
        {% for section in sections %}      
            <h2 class="text-center mb-4">{{ section.section_name }}</h2>
            <div class="row">
                {% for produit in section.produits %}        
                    <div class="col-md-4 mb-4">
                        <div class="card">
                            <img src="{{ 'http://127.0.0.1:3000' ~ produit.image_path }}" class="card-img-top" alt="{{ produit.name }}">
                            <div class="card-body">
                                <h5 class="card-title">{{produit.name}}</h5>
                                <p class="card-text">{{produit.description}}</p>
                                <p class="card-text">
									<strong>
										{% if app.session.has("loyalty_points") and app.session.get("loyalty_points") == 8 %}
											{{(produit.price * 0.9)|price}}
										{% else %}
											{{produit.price|price}}
										{% endif %}
									</strong>
								</p>
                            </div>
                        </div>
                    </div>
                {% endfor %}            
            </div>         
        {% endfor %}
    </div>
</section>
{% endblock %}