{% extends 'base.html.twig' %}

{% block title %}
	{{ parent() }}
	| Administration
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('js/admin.js')}}"></script>
{% endblock %}

{% block body %}
	<h3 class="d-flex justify-content-center mt-4">
		<strong>
			Sections 
			<span onclick="openModalAjoutSection()" class="rounded-circle" style="color:green; cursor:pointer;">+</span>
		</strong>
	</h3>
	<div class="modal ModalAjoutSection">
		<div class="modal-content">
			<span>					
				<span class="close closeModal">&times;</span>
			</span>
			<h5 class="d-flex justify-content-center"><strong>Ajout Section Produit</strong></h5>
			
			<div>
				<form action="/admin" method="post">
					<input type="hidden" name="valueData" value="ajoutSection">
					<div class='form-group d-flex mt-2'>
						<input type='text' class='form-control' name='sectionName' placeholder='Nouvelle Section' required>
					</div>
					<br>
					<span class="d-flex justify-content-evenly">
						<button type='submit' class="btn btn-warning">Confirmer</button>
						<button type="reset" class="btn btn-danger closeModal">Annuler</button>
					</span>	
				</form>
			</div>
		</div>
	</div>


	<table class="mt-4">
		<thead>
			<tr>
				<th scope="col">Identifiant</th>
				<th scope="col">Name</th>
				<th scope="col">Actions</th>
			</tr>
		</thead>

		<tbody>
			{% for section in sections %}

				<div class="modal ModalEditSection" data-section-id="{{ section.id }}">
					<div class="modal-content">
						<span>					
							<span class="close closeModal">&times;</span>
						</span>
						<h5 class="d-flex justify-content-center"><strong>Êdition section n°{{section.id}}?</strong></h5>
						
						<div>
							<form action="/admin" method="post">
								<input type="hidden" name="valueData" value="editSection">
								<input type="hidden" name="sectionId" value="{{section.id}}">
								<div class='form-group d-flex mt-2'>
									<input type='text' class='form-control' name='sectionName' placeholder='{{section.section_name}}' required>
								</div>
								<br>
								<span class="d-flex justify-content-evenly">
									<button type='submit' class="btn btn-warning">Confirmer</button>
									<button type="reset" class="btn btn-danger closeModal">Annuler</button>
								</span>	
							</form>
						</div>
					</div>
				</div>

				<div class="modal ModalDelSection" data-section-id="{{ section.id }}">
					<div class="modal-content">
						<span>
							<span class="close closeModal">&times;</span>
						</span>
						<h5 class="d-flex justify-content-center"><strong>Êtes-vous sûr de vouloir supprimer la section n°{{section.id}}?</strong></h5>
						<br>
						<form action="/admin" method="post" class="grid gap-5">
							<input type="hidden" name="valueData" value="deleteSection">
							<input type="hidden" name="sectionId" value="{{section.id}}">
							<br>
							<span class="d-flex justify-content-evenly mt-4">
								<button type='submit' class="btn btn-warning">Confirmer</button>
								<button type="reset" class="btn btn-danger closeModal">Annuler</button>
							</span>	
						</form>
					</div>
				</div>

				<tr>
					<th scope="row">{{ section.id }}</th>
					<td>{{ section.section_name }}</td>

					<td class="d-flex justify-content-center align-items-center grid gap-3">
						<span class="toggle-section toogleButtons" data-section-id="{{ section.id }}">+</span>
						<span class="toogleButtons" onclick="openModalEditSection({{ section.id }})">/</span>
						<span class="toogleButtons" onclick="openModalDelSection({{ section.id }})">del</span>
					</td>
				</tr>
				<tr class="sub-section hidden" data-section-id="{{ section.id }}">
					<td colspan="3">
						<div class="modal ModalAjoutProduit">
							<div class="modal-content">
								<span>
									<span class="close closeModal">&times;</span>
								</span>
								<h5 class="d-flex justify-content-center"><strong>Insérer un produit dans la section n°{{section.id}}</strong></h5>
								<br>
								<form action="/admin" method="post" enctype="multipart/form-data" class="mt-4">
									<input type="hidden" name="valueData" value="ajoutProduit">
									<input type="hidden" name="sectionId" value="{{section.id}}">
									<div class='form-group d-flex flex-column grid gap-2'>
										<input type="text" class='form-control' name="produitName" placeholder="Nom du produit">
										<input type="text" class='form-control' name="produitDescription" placeholder="Description pour le produit">
										<input type="file" class='form-control' name="produitImage" accept=".png, .jpg, .jpeg">
										<input type="number" class='form-control' name="produitPrice" placeholder="{{'10.75'|price}}">
									</div>
									<br>
									<span class="d-flex justify-content-evenly">
										<button type='submit' class="btn btn-warning">Confirmer</button>
										<button type="reset" class="btn btn-danger closeModal">Annuler</button>
									</span>	
								</form>
							</div>
						</div>
						<h4 class="d-flex justify-content-center mt-2 mb-4">
							<strong>
								Produits 
								<span class="rounded-circle" onclick="openModalAddProduit()" style="color:green; cursor:pointer;">+</span>
							</strong>
						</h4>

						<table class="mt-3">
							<thead>
								<tr>
									<th scope="col">Produit Id</th>
									<th scope="col">Nom</th>
									<th scope="col">Description</th>
									<th scope="col">ImagePath</th>
									<th scope="col">Prix</th>
									<th scope="col">Actions</th>
									<th scope="col">Selection du moment</th>
								</tr>
							</thead>
							<tbody>
								{% for item in section.produits %}
									<div class="modal ModalEditProduit" data-produit-id="{{item.id}}">
										<div class="modal-content">
											<span>
												<span class="close closeModal">&times;</span>
											</span>
											<h5 class="d-flex justify-content-center"><strong>Êdition produit n°{{item.id}}?</strong></h5>
											<br>
											<form action="/admin" method="post" enctype="multipart/form-data" class="mt-4">
												<input type="hidden" name="valueData" value="editProduit">
												<input type="hidden" name="sectionId" value="{{section.id}}">
												<input type="hidden" name="produitId" value="{{item.id}}">

												<div class='form-group d-flex flex-column grid gap-2'>
													<input type="text" class='form-control' name="produitName" placeholder="{{item.name}}">
													<input type="text" class='form-control' name="produitDescription" placeholder="{{item.description}}">
													<input type="file" class='form-control' name="produitImage" accept=".png, .jpg, .jpeg">
													<input type="number" class='form-control' name="produitPrice" placeholder="{{item.price|price}}">
													<select class="form-control" style="cursor:pointer;" name="selectSection">
														{% for sec in sections %}
															<option value="{{sec.id}}" {% if item.section_produit == sec.id %}selected{% endif %}>{{sec.id ~ " - " ~ sec.section_name}}</option>
														{% endfor %}
													</select>
												</div>
												<br>
												<span class="d-flex justify-content-evenly mt-4">
													<button type='submit' class="btn btn-warning">Confirmer</button>
													<button type="reset" class="btn btn-danger closeModal">Annuler</button>
												</span>	
											</form>
										</div>
									</div>
									<div class="modal ModalDelProduit" data-produit-id="{{item.id}}">
										<div class="modal-content">
											<span>
												<span class="close closeModal">&times;</span>
											</span>
											<h5 class="d-flex justify-content-center"><strong>Êtes-vous sûr de vouloir supprimer le produit n°{{item.id}}?</strong></h5>
											<br>
											<form action="/admin" method="post">
												<input type="hidden" name="valueData" value="deleteProduit">
												<input type="hidden" name="produitId" value="{{item.id}}">
												<input type="hidden" name="sectionId" value="{{section.id}}">
												<br>
												<span class="d-flex justify-content-evenly mt-4">
													<button type='submit' class="btn btn-warning">Confirmer</button>
													<button type="reset" class="btn btn-danger closeModal">Annuler</button>
												</span>	
											</form>
										</div>
									</div>
									<tr>
										<th>{{ item.id }}</th>
										<td>{{ item.name }}</td>
										<td>{{ item.description }}</td>
										<td>{{ item.image_path }}</td>
										<td>{{ item.price|price }}</td>
										<td class="d-flex justify-content-center align-items-center grid gap-2">
											<span onclick="openModalEditProduit({{ item.id }})" style="cursor:pointer;">/</span>
											<span onclick="openModalDelProduit({{ item.id }})" style="cursor:pointer;">del</span>
										</td>
										<td>
											<form action="/admin" method="post">
												{% if item.selected %}
													<input type="hidden" name="valueData" value="updateSelected">
													<input type="hidden" name="selectedValue" value='false'>
													<input type="hidden" name="sectionId" value="{{section.id}}">
													<input type="hidden" name="produitId" value="{{item.id}}">
													<button type="submit" class="btn btn-danger">NON</button>				
												{% else %}
													<input type="hidden" name="valueData" value="updateSelected">
													<input type="hidden" name="selectedValue" value='true'>
													<input type="hidden" name="sectionId" value="{{section.id}}">
													<input type="hidden" name="produitId" value="{{item.id}}">
													<button type="submit" class="btn btn-success">OUI</button>
												{% endif %}
											</form>
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
{% endblock %}
