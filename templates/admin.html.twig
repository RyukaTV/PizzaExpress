{% extends 'base.html.twig' %}

{% block title %}
	{{ parent() }}
	| Administration
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('js/admin.js')}}"></script>
{% endblock %}

{% set developSection = false %}

{% block body %}
	<table class="mt-5">
		<thead>
			<tr>
				<th scope="col">Id</th>
				<th scope="col">Name</th>
				<th scope="col">Actions</th>
			</tr>
		</thead>


		<div id="myModal" class="modal">
			<div class="modal-content">
				<span><span class="close closeModal">&times;</span></span>
				<p class="d-flex justify-conten-center">Êtes-vous sûr de vouloir supprimer ?</p>
				<span class="grid gap-5">
					<button class="btn btn-warning">Confirmer</button>
					<button class="btn btn-danger closeModal">Annuler</button>
				</span>
			</div>
		</div>

		<tbody>
			{% for section in sections %}
				<tr>
					<th scope="row">{{ section.id }}</th>
					<td>{{ section.section_name }}</td>

					<td class="grid gap-5">
						<span class="toggle-section toogleButtons" data-section-id="{{ section.id }}">+</span>
						<span class="toogleButtons">/</span>
						<span class="toogleButtons" onclick="openModal()">del</span>
					</td>
				</tr>
				<tr class="sub-section hidden" data-section-id="{{ section.id }}">
					<td colspan="3">
						<table class="mt-3">
							<thead>
								<tr>
									<th scope="col">Produit Id</th>
									<th scope="col">Nom</th>
									<th scope="col">Description</th>
									<th scope="col">ImagePath</th>
									<th scope="col">Prix</th>
									<th scope="col">Selection du moment</th>
								</tr>
							</thead>
							<tbody>
								{% for item in section.produits %}
									<tr>
										<th>{{ item.id }}</th>
										<td>{{ item.name }}</td>
										<td>{{ item.description }}</td>
										<td>{{ item.image_path }}</td>
										<td>{{ item.price|price }}</td>
										{% if item.selected %}
											<td>Oui</td>
										{% else %}
											<td>Non</td>
										{% endif %}
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
{% endblock %}
