{% extends 'base.html.twig' %}

{% block title %}
	{{ parent() }}
	| Administration
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('js/admin.js')}}"></script>
{% endblock %}

{% block body %}
	<table class="mt-5">
		<thead>
			<tr>
				<th scope="col">Id</th>
				<th scope="col">Name</th>
				<th scope="col">Actions</th>
			</tr>
		</thead>

		<tbody>
			{% for section in sections %}

				<div class="modal ModalEditSection" data-section-id="{{ section.id }}">
					<div class="modal-content">
						<span>					
							<span class="close closeModal">&times;</span>
							<p class="d-flex justify-conten-center">Êdition section n°{{section.id}}?</p>
						</span>
						
						<div class="grid gap-2">
							<form action="/admin" method="post">
								<input type="hidden" name="valueData" value="editSection">
								<input type="hidden" name="sectionId" value="{{section.id}}">
								<div class='form-group'>
									<input type='text' class='form-control' name='sectionName' placeholder='{{section.section_name}}' required>
								</div>

								<span class="grid gap-5 mt-5">
									<button type='submit' class="btn btn-warning">Confirmer</button>
									<button type="reset" class="btn btn-danger closeModal">Annuler</button>
								</span>	
							</form>
						</div>
					</div>
				</div>

				<div class="modal ModalDelSection" data-section-id="{{ section.id }}">
					<div class="modal-content">
						<span>
							<span class="close closeModal">&times;</span>
						</span>
						<p class="d-flex justify-conten-center">Êtes-vous sûr de vouloir supprimer la section n°{{section.id}}?</p>
						<form action="/admin" method="post" class="grid gap-5">
							<input type="hidden" name="valueData" value="deleteSection">
							<input type="hidden" name="sectionId" value="{{section.id}}">
							<button type="submit" class="btn btn-warning">Confirmer</button>
							<button type="reset" class="btn btn-danger closeModal">Annuler</button>
						</form>
					</div>
				</div>

				<tr>
					<th scope="row">{{ section.id }}</th>
					<td>{{ section.section_name }}</td>

					<td class="grid gap-5">
						<span class="toggle-section toogleButtons" data-section-id="{{ section.id }}">+</span>
						<span class="toogleButtons" onclick="openModalEditSection({{ section.id }})">/</span>
						<span class="toogleButtons" onclick="openModalDelSection({{ section.id }})">del</span>
					</td>
				</tr>
				<tr class="sub-section hidden" data-section-id="{{ section.id }}">
					<td colspan="3">
						<table class="mt-3">
							<thead>
								<tr>
									<th scope="col">Produit Id</th>
									<th scope="col">Nom</th>
									<th scope="col">Description</th>
									<th scope="col">ImagePath</th>
									<th scope="col">Prix</th>
									<th scope="col">Selection du moment</th>
								</tr>
							</thead>
							<tbody>
								{% for item in section.produits %}
									<tr>
										<th>{{ item.id }}</th>
										<td>{{ item.name }}</td>
										<td>{{ item.description }}</td>
										<td>{{ item.image_path }}</td>
										<td>{{ item.price|price }}</td>
										{% if item.selected %}
											<td>Oui</td>
										{% else %}
											<td>Non</td>
										{% endif %}
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
{% endblock %}
